# .env
TOLLGATE_LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
TOLLGATE_LLM_PRIMARY_API_KEY=sk-or-your-key-here
TOLLGATE_LLM_PRIMARY_MODEL=anthropic/claude-sonnet-4.5

# optional second provider, tried only if the first fails
TOLLGATE_LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
TOLLGATE_LLM_FALLBACK_API_KEY=gsk-your-key-here
TOLLGATE_LLM_FALLBACK_MODEL=<a Groq model id>

# optional: a different model just for Intake
TOLLGATE_LLM_INTAKE_MODEL=